modules = ["python-3.12", "bash"]
run = "pip install -q -r requirements.txt && python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000"

[nix]
channel = "stable-25_05"
packages = ["postgresql"]

[deployment]
deploymentTarget = "autoscale"
# GitHub main, not the workspace (scripts/build.sh, scripts/deploy_source.py).
build = ["bash", "scripts/build.sh"]
run = ["sh", "-c", "python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000"]

[[ports]]
localPort = 8000
externalPort = 80

# "Sync from GitHub": fast-forward the workspace to GitHub main, install main's
# requirements, then apply migrations/ to the DEVELOPMENT database (DATABASE_URL
# here is the workspace's). Production's schema follows it at the next Republish,
# whose SQL is read; the deployment never changes its own schema (app/migrate.py).
[[workflows.workflow]]
name = "Sync from GitHub"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/sync-from-github.sh && pip install -q -r requirements.txt && python3 -m app.migrate"
